# Copy to .env.local for local dev. Set the same values in Vercel → Project → Settings → Environment Variables.

# Square (Developer Dashboard → your app → Credentials)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "production" or "sandbox"
SQUARE_ENVIRONMENT=production
# Optional: support email shown on the Square checkout page
SQUARE_SUPPORT_EMAIL=

# Public site URL, used for the post-payment redirect
NEXT_PUBLIC_SITE_URL=https://www.dramaticsnyc.com
# Optional: Square eGift card page (Square Dashboard → Gift Cards → eGift Cards)
NEXT_PUBLIC_GIFT_CARDS_URL=
