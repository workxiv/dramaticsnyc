# Copy to .env.local for local dev. Set the same values in Vercel → Project → Settings → Environment Variables.

# Square (Developer Dashboard → your app → Credentials)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "production" or "sandbox"
SQUARE_ENVIRONMENT=production
# Optional: support email shown on the Square checkout page
SQUARE_SUPPORT_EMAIL=

# Public site URL, used for the post-payment redirect
NEXT_PUBLIC_SITE_URL=https://www.dramaticsnyc.com
# Optional: override the Gift Cards link (default /shop/gift-cards, per-salon SalonTarget eGift)
NEXT_PUBLIC_GIFT_CARDS_URL=

# New-order emails to the salon (Square → webhook → Resend)
# Developer Console → Webhooks → your subscription → Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact notification URL registered with Square (optional; defaults to https://<host>/api/square/webhook)
SQUARE_WEBHOOK_URL=
# resend.com → API Keys
RESEND_API_KEY=
# Who gets the "You've got a new order" email (comma-separated)
ORDER_NOTIFY_TO=dramaticsnycs@gmail.com
# Sender. Use a verified domain address once dramaticsnyc.com is verified in Resend.
ORDER_NOTIFY_FROM=Dramatics NYC <orders@dramaticsnyc.com>
